# Copy this file to .env and adjust as needed.
# Every setting has a default, so a .env file is optional.
# Environment variables take precedence over .env.
# Relative paths are resolved from the project root.

# LLM provider (any OpenAI-compatible API; defaults target local Ollama)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=120
# "none" disables thinking on reasoning models. Use low/medium/high to enable
# it, or leave empty to omit the parameter for providers that reject it.
LLM_REASONING_EFFORT=none

# Models
CHAT_MODEL=qwen3.5:9b
EMBEDDING_MODEL=nomic-embed-text

# Retrieval
# Minimum cosine similarity for a chunk to be used. Lower it if valid
# questions return "could not find relevant information".
MIN_RELEVANCE_SCORE=0.5

# Paths
DATABASE_PATH=data/rag.db
CORPUS_DIR=corpus