# Copy this file to .env and adjust as needed.
# Environment variables take precedence over values in .env.
# Relative paths are resolved from the project root.

# LLM provider
# Local Ollama example: http://localhost:11434/v1
# Hosted provider example: https://api.openai.com/v1
LLM_BASE_URL=http://localhost:11434/v1
# Use the provider's API key. Ollama commonly accepts any non-empty value.
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=120
# "none" disables thinking on reasoning models. Use low/medium/high to enable
# it, or leave empty to omit the parameter for providers that reject it.
LLM_REASONING_EFFORT=none

# Models
# Examples below are Ollama model names; choose models available to your provider.
CHAT_MODEL=qwen3.5:9b
JUDGE_MODEL=ibm/granite4.1:3b
EMBEDDING_MODEL=nomic-embed-text
# Smaller local judge alternative: qwen3.5:0.8b

# Retrieval
# Minimum cosine similarity for a chunk to be used. Lower it if valid
# questions return "could not find relevant information"; tune against your corpus.
MIN_RELEVANCE_SCORE=0.5

# Paths
# Paths may be absolute or relative to the project root.
DATABASE_PATH=data/rag.db
CORPUS_DIR=corpus
# Process every top-level JSON dataset in this directory.
EVALUATION_DATASET=evals/datasets
# Directory where one <dataset-name>-report.json is written per dataset.
EVALUATION_REPORTS=evals/reports
# Maximum chunks retrieved for evaluation and used as API top_k when omitted.
EVALUATION_TOP_K=5

# API server
# Use 0.0.0.0 to expose the server on the network; keep localhost for local use.
API_HOST=127.0.0.1
API_PORT=8000